# Copy to .env.local and fill in. Never commit .env.local.
# Without a key, /api/chat replies with canned lines so the demo still works.
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=openrouter/free

# Supabase project (Settings > API). The anon key is safe to expose to the browser.
# Without these, the lobby only connects tabs on the same computer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
